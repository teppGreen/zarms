---
title: ZARMS - Database Schema
---

erDiagram
    logs {
        uuid id PK "ログID"
        varchar operation_type_key "操作タイプキー"
        varchar table_name "テーブル名"
        varchar record_id "レコードID"
        text data "記録されたデータ"
        text remark "システム備考"
        uuid created_by "作成者"
        datetime created_at "作成日時"
    }
    boards {
        uuid id PK "ボードID"
        int display_id "ボードID(連番)"
        varchar email "メールアドレス"
        varchar name "ボード名"
        text description "ボード説明"
        boolean is_active "有効"
        text remark "システム備考"
        uuid created_by "作成者"
        datetime created_at "作成日時"
        uuid updated_by "最終更新者"
        datetime updated_at "最終更新日時"
    }
    comments {
        uuid id PK "コメントID"
        int display_id "コメントID(連番)"
        text content "コメント内容"
        uuid mentioned_to "メンション先"
        varchar related_table "関連テーブル"
        uuid related_id "関連ID"
        text remark "システム備考"
        uuid created_by "作成者"
        datetime created_at "作成日時"
        uuid updated_by "最終更新者"
        datetime updated_at "最終更新日時"
    }
    directories {
        uuid id PK "組織ID"
        int display_id "組織ID(連番)"
        uuid parent_directory_id "親組織ID"
        varchar directory_type_key "組織タイプキー"
