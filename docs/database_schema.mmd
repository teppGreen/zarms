        varchar slack_channel_url "SlackチャンネルURL: 企画応募フォーム: これまでの活動の実態・実績がわかるようなSlackチャンネル"
        varchar gfolder_id "フォルダID"
        boolean is_active "有効"
        text remark "システム備考"
        uuid created_by "作成者"
        datetime created_at "作成日時"
        uuid updated_by "最終更新者"
        datetime updated_at "最終更新日時"
    }
    apps {
        uuid id PK "アプリID"
        varchar name "アプリ名"
        varchar url "アプリURL"
        text remark "システム備考"
        uuid created_by "作成者"
        datetime created_at "作成日時"
        uuid updated_by "最終更新者"
        datetime updated_at "最終更新日時"
    }
    members {
        uuid id PK "メンバーID"
        varchar email "メールアドレス"
        varchar slack_profile_url "SlackプロフィールURL"
        varchar name "氏名"
        varchar display_name "表示名"
        varchar profile_photo_url "プロフィール写真URL"
        boolean is_active "有効"
        text remark "システム備考"
        uuid created_by "作成者"
        datetime created_at "作成日時"
        uuid updated_by "最終更新者"
        datetime updated_at "最終更新日時"
    }
    plan_assignments {
        uuid id PK "企画割り当てID"
        uuid plan_id "企画ID"
        uuid member_id "メンバーID"
        varchar role "役割"
        boolean is_active "有効"
        text remark "システム備考"
        uuid created_by "作成者"
        datetime created_at "作成日時"
        uuid updated_by "最終更新者"
        datetime updated_at "最終更新日時"
    }
    directory_assignments {
        uuid id PK "組織割り当てID"
        uuid directory_id "組織ID"
        uuid member_id "メンバーID"
        varchar role "役割"
        boolean is_active "有効"
        text remark "システム備考"
        uuid created_by "作成者"
        datetime created_at "作成日時"
        uuid updated_by "最終更新者"
        datetime updated_at "最終更新日時"
    }
    tasks {
        uuid id PK "タスクID"
        int display_id "タスクID(連番)"
        uuid parent_task_id "親タスクID"
        uuid board_id "ボードID"
        varchar name "タスク名"
        text description "タスク説明"
        datetime starts_at "開始日時"
        datetime ends_at "終了日時"
        varchar task_status_key "タスクステータスキー"
        varchar priority_key "優先度キー"
        uuid processed_by "進行者"
        uuid reviewed_by "確認者"
        uuid received_by "受領者"
        text remark "システム備考"
        uuid created_by "作成者"
        datetime created_at "作成日時"
        uuid updated_by "最終更新者"
        datetime updated_at "最終更新日時"
    }
    lists {
        uuid id PK "リストID"
        int index "インデックス"
        uuid task_id "タスクID"
        boolean is_done "完了"
        varchar name "リスト名"
        uuid assign_to "割り当て先"
        text remark "システム備考"
        uuid created_by "作成者"
        datetime created_at "作成日時"
        uuid updated_by "最終更新者"
        datetime updated_at "最終更新日時"
    }
    links {
        uuid id PK "リンクID"
        int index "インデックス"
        uuid task_id "タスクID"
        varchar label "ラベル"
        varchar url "URL"
        text remark "システム備考"
        uuid created_by "作成者"
        datetime created_at "作成日時"
        uuid updated_by "最終更新者"
        datetime updated_at "最終更新日時"
    }
    files {
        uuid id PK "ファイルID"
        int index "インデックス"
        uuid task_id "タスクID"
        varchar gfile_id "ファイルID"
        text remark "システム備考"
        uuid created_by "作成者"
        datetime created_at "作成日時"
        uuid updated_by "最終更新者"
        datetime updated_at "最終更新日時"
    }
