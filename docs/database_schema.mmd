---
title: ZARMS - Database Schema
---

erDiagram
    logs {
        uuid id PK "ログID"
        varchar operation_type_key "操作タイプキー"
        varchar table_name "テーブル名"
        varchar record_id "レコードID"
        text data "記録されたデータ"
        text remark "システム備考"
        uuid created_by "作成者"
        datetime created_at "作成日時"
    }
    boards {
        uuid id PK "ボードID"
        int display_id "ボードID(連番)"
        varchar email "メールアドレス"
        varchar name "ボード名"
        text description "ボード説明"
        boolean is_active "有効"
        text remark "システム備考"
        uuid created_by "作成者"
        datetime created_at "作成日時"
        uuid updated_by "最終更新者"
        datetime updated_at "最終更新日時"
    }
    comments {
        uuid id PK "コメントID"
        int display_id "コメントID(連番)"
        text content "コメント内容"
        uuid mentioned_to "メンション先"
        varchar related_table "関連テーブル"
        uuid related_id "関連ID"
        text remark "システム備考"
        uuid created_by "作成者"
        datetime created_at "作成日時"
        uuid updated_by "最終更新者"
        datetime updated_at "最終更新日時"
    }
    directories {
        uuid id PK "組織ID"
        int display_id "組織ID(連番)"
        uuid parent_directory_id "親組織ID"
        varchar directory_type_key "組織タイプキー"
        varchar name "組織名: 企画応募フォーム：代表者の所属する団体・コミュニティ名"
        varchar slack_channel_url "SlackチャンネルURL: 企画応募フォーム: これまでの活動の実態・実績がわかるようなSlackチャンネル"
        varchar gfolder_id "フォルダID"
        boolean is_active "有効"
        text remark "システム備考"
        uuid created_by "作成者"
        datetime created_at "作成日時"
        uuid updated_by "最終更新者"
        datetime updated_at "最終更新日時"
    }
    apps {
        uuid id PK "アプリID"
        varchar name "アプリ名"
        varchar url "アプリURL"
        text remark "システム備考"
        uuid created_by "作成者"
        datetime created_at "作成日時"
        uuid updated_by "最終更新者"
        datetime updated_at "最終更新日時"
    }
    members {
        uuid id PK "メンバーID"
        varchar email "メールアドレス"
        varchar slack_profile_url "SlackプロフィールURL"
        varchar name "氏名"
        varchar display_name "表示名"
        varchar profile_photo_url "プロフィール写真URL"
        boolean is_active "有効"
        text remark "システム備考"
        uuid created_by "作成者"
        datetime created_at "作成日時"
        uuid updated_by "最終更新者"
        datetime updated_at "最終更新日時"
    }
    member_assignments {
        uuid id PK "メンバー割り当てID"
        uuid member_id "メンバーID"
        varchar related_table "割り当て先テーブル"
        uuid related_id "割り当て先ID"
        varchar role "役割"
        boolean is_active "有効"
        text remark "システム備考"
        uuid created_by "作成者"
        datetime created_at "作成日時"
        uuid updated_by "最終更新者"
        datetime updated_at "最終更新日時"
    }
    tasks {
        uuid id PK "タスクID"
        int display_id "タスクID(連番)"
        uuid parent_task_id "親タスクID"
        uuid board_id "ボードID"
        varchar name "タスク名"
        text description "タスク説明"
        datetime starts_at "開始日時"
        datetime ends_at "終了日時"
        varchar task_status_key "タスクステータスキー"
        varchar priority_key "優先度キー"
        uuid processed_by "進行者"
        uuid reviewed_by "確認者"
        uuid received_by "受領者"
        text remark "システム備考"
        uuid created_by "作成者"
        datetime created_at "作成日時"
        uuid updated_by "最終更新者"
        datetime updated_at "最終更新日時"
    }
    lists {
        uuid id PK "リストID"
        int index "インデックス"
        uuid task_id "タスクID"
        boolean is_done "完了"
        varchar name "リスト名"
        uuid assign_to "割り当て先"
        text remark "システム備考"
        uuid created_by "作成者"
        datetime created_at "作成日時"
        uuid updated_by "最終更新者"
        datetime updated_at "最終更新日時"
    }
    links {
        uuid id PK "リンクID"
        int index "インデックス"
        uuid task_id "タスクID"
        varchar label "ラベル"
        varchar url "URL"
        text remark "システム備考"
        uuid created_by "作成者"
        datetime created_at "作成日時"
        uuid updated_by "最終更新者"
        datetime updated_at "最終更新日時"
    }
    files {
        uuid id PK "ファイルID"
        int index "インデックス"
        uuid task_id "タスクID"
        varchar gfile_id "ファイルID"
        text remark "システム備考"
        uuid created_by "作成者"
        datetime created_at "作成日時"
        uuid updated_by "最終更新者"
        datetime updated_at "最終更新日時"
    }
    system_updates {
        uuid id PK "アップデートID"
        varchar version "バージョン番号"
        varchar title "アップデートタイトル"
        text description "アップデート内容"
        text remark "システム備考"
        uuid created_by "作成者"
        datetime created_at "作成日時"
        uuid updated_by "最終更新者"
        datetime updated_at "最終更新日時"
    }
    logs }|--|| members : "created_by"
    apps }|--|| members : "created_by"
    apps }|--|| members : "updated_by"
    boards }|--|| members : "created_by"
    boards }|--|| members : "updated_by"
    comments }|--|| boards : "mentioned_to"
    comments }|--|| members : "created_by"
    comments }|--|| members : "updated_by"
    directories }|--|| directories : "parent_directory_id"
    directories }|--|| members : "created_by"
    directories }|--|| members : "updated_by"
    links }|--|| tasks : "task_id"
    links }|--|| members : "created_by"
    links }|--|| members : "updated_by"
    members }|--|| members : "created_by"
    members }|--|| members : "updated_by"
    member_assignments }|--|| members : "member_id"
    member_assignments }|--|| members : "created_by"
    member_assignments }|--|| members : "updated_by"
    tasks }|--|| tasks : "parent_task_id"
    tasks }|--|| members : "processed_by"
    tasks }|--|| members : "reviewed_by"
    tasks }|--|| members : "received_by"
    tasks }|--|| members : "created_by"
    tasks }|--|| members : "updated_by"
    lists }|--|| tasks : "task_id"
    lists }|--|| members : "assign_to"
    lists }|--|| members : "created_by"
    lists }|--|| members : "updated_by"
    files }|--|| tasks : "task_id"
    files }|--|| members : "created_by"
    files }|--|| members : "updated_by"
    system_updates }|--|| members : "created_by"
    system_updates }|--|| members : "updated_by"