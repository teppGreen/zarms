{
    "name": "zarms-monorepo",
    "version": "1.0.0",
    "private": true,
    "description": "ZARMS Monorepo",
    "workspaces": [
        "projects/*"
    ],
    "scripts": {
        "deploy:database:dev": "npm run deploy:dev -w projects/database",
        "deploy:database:prod": "npm run deploy:prod -w projects/database",
        "deploy:frontend:dev": "npm run deploy:dev -w projects/frontend",
        "deploy:frontend:prod": "npm run deploy:prod -w projects/frontend",
        "deploy:mobile-app:dev": "npm run deploy:dev -w projects/mobile-app",
        "deploy:mobile-app:prod": "npm run deploy:prod -w projects/mobile-app",
        "deploy:all:dev": "npm run deploy:database:dev && npm run deploy:frontend:dev && npm run deploy:mobile-app:dev",
        "deploy:all:prod": "npm run deploy:database:prod && npm run deploy:frontend:prod && npm run deploy:mobile-app:prod",
        "watch:database:dev": "npm run watch:dev -w projects/database",
        "watch:frontend:dev": "npm run watch:dev -w projects/frontend",
        "watch:mobile-app:dev": "npm run watch:dev -w projects/mobile-app",
        "check:frontend:utils-reassign": "node scripts/check-app-utils-reassign.js",
        "update:ui-deps": "node scripts/update-ui-deps.js"
    },
    "devDependencies": {
        "@google/clasp": "^2.4.2"
    }
}
